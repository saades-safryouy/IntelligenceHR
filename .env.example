DEMO_MANAGER_EMAIL=demo.manager.01@intelligence-rh.example.test
DEMO_MANAGER_PASSWORD=TestPassword2026!

# 3. Employee Platform (Dashboard: /employee/dashboard)
DEMO_EMPLOYEE_EMAIL=demo.employee.01@intelligence-rh.example.test
DEMO_EMPLOYEE_PASSWORD=TestPassword2026!

