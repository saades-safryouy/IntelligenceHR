APP_NAME=IntelligenceHR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-BACKEND-URL.up.railway.app
APP_TIMEZONE=Africa/Casablanca

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL (TiDB Cloud Serverless). The deploy creates a database named
# `intelligencehr` on the existing TiDB cluster; fill in real values in
# Railway env vars — never commit real credentials.
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=intelligencehr
DB_USERNAME=
DB_PASSWORD=
# TiDB requires TLS. Path to the CA bundle inside the container.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Sanctum SPA auth: the frontend origin(s), comma-separated, no trailing slash.
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

FILESYSTEM_DISK=local

# Super-admin created by the seeder (DatabaseSeeder). Set both before
# running `php artisan db:seed`; leave unset to skip creating it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
